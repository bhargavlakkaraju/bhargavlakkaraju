generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  domain    String?
  industry  String?
  location  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  deals     Deal[]
}

model Campaign {
  id        String    @id @default(cuid())
  name      String    @unique
  client    String?
  // ACTIVE | PAUSED | COMPLETED
  status    String    @default("ACTIVE")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  deals     Deal[]
}

model Contact {
  id         String     @id @default(cuid())
  firstName  String
  lastName   String?
  email      String?    @unique
  phone      String?
  title      String?
  // Lead lifecycle: NEW | CONTACTED | QUALIFIED | CUSTOMER | LOST
  status     String     @default("NEW")
  // Where this contact came from (e.g. "google-sheet", "chatbot", "zapier", "manual")
  source     String     @default("manual")
  // Comma-separated tags
  tags       String?
  // Arbitrary extra fields pushed by external tools, stored as JSON string
  customData String?
  companyId  String?
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deals      Deal[]
  activities Activity[]

  @@index([status])
  @@index([campaignId])
}

model Deal {
  id            String     @id @default(cuid())
  title         String
  value         Float      @default(0)
  currency      String     @default("INR")
  // Pipeline: LEAD_IN | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  stage         String     @default("LEAD_IN")
  expectedClose DateTime?
  notes         String?
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  activities    Activity[]

  @@index([stage])
}

model Activity {
  id        String   @id @default(cuid())
  // NOTE | CALL | EMAIL | MEETING | TASK | SYSTEM
  type      String   @default("NOTE")
  content   String
  // For TASK type
  dueAt     DateTime?
  completed Boolean  @default(false)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([dealId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // The full key, generated once. Shown in settings so tools can be configured.
  key        String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
}

// Log of every payload pushed by an external tool, for debugging integrations.
model IngestEvent {
  id        String   @id @default(cuid())
  apiKeyName String?
  endpoint  String
  // RECEIVED | PROCESSED | FAILED
  status    String   @default("RECEIVED")
  payload   String
  result    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
