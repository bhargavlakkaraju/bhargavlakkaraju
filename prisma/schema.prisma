generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication & Users ─────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           String    @default("MEMBER")
  avatarUrl      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoicesCreated  Invoice[]
  paymentsRecorded Payment[]
  notifications    Notification[]
  workflowLogs     WorkflowLog[]
  tasksAssigned    Task[]         @relation("TaskAssignee")
  projectsLed      Project[]      @relation("ProjectLead")
  activities       Activity[]
  gmailAccount     GmailAccount?

  @@index([organizationId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String   @default("US")
  currency    String   @default("USD")
  taxRate     Float    @default(0)
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  customers   Customer[]
  invoices    Invoice[]
  payments    Payment[]
  products    Product[]
  categories  Category[]
  expenses    Expense[]
  workflows   Workflow[]
  reminders   Reminder[]
  projects    Project[]
  tasks       Task[]
  activities  Activity[]
}

// ─── Customers ──────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String   @default("US")
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
  payments Payment[]
  projects Project[]

  @@index([organizationId])
  @@index([email])
}

// ─── Invoices ───────────────────────────────────────────────────────

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String
  status         String   @default("DRAFT")
  issueDate      DateTime @default(now())
  dueDate        DateTime
  subtotal       Float    @default(0)
  taxAmount      Float    @default(0)
  discountAmount Float    @default(0)
  totalAmount    Float    @default(0)
  paidAmount     Float    @default(0)
  notes          String?
  terms          String?

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]
  reminders Reminder[]

  @@unique([invoiceNumber, organizationId])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  taxRate     Float   @default(0)
  amount      Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// ─── Payments ───────────────────────────────────────────────────────

model Payment {
  id             String   @id @default(cuid())
  amount         Float
  method         String   @default("BANK_TRANSFER")
  status         String   @default("PENDING")
  reference      String?
  notes          String?
  paidAt         DateTime?

  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordedById   String
  recordedBy     User @relation(fields: [recordedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
}

// ─── Inventory / Products ───────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String?
  description    String?
  unitPrice      Float
  costPrice      Float    @default(0)
  quantity       Int      @default(0)
  reorderLevel   Int      @default(10)
  unit           String   @default("pcs")
  isActive       Boolean  @default(true)

  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineItems      InvoiceLineItem[]
  stockMovements StockMovement[]

  @@unique([sku, organizationId])
  @@index([organizationId])
  @@index([categoryId])
}

model StockMovement {
  id          String   @id @default(cuid())
  type        String
  quantity    Int
  reason      String?
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([productId])
}

// ─── Expenses ───────────────────────────────────────────────────────

model Expense {
  id             String   @id @default(cuid())
  description    String
  amount         Float
  category       String
  date           DateTime @default(now())
  vendor         String?
  receiptUrl     String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([date])
}

// ─── AI Workflows ───────────────────────────────────────────────────

model Workflow {
  id             String   @id @default(cuid())
  name           String
  description    String?
  trigger        String
  actions        String
  isActive       Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs WorkflowLog[]

  @@index([organizationId])
}

model WorkflowLog {
  id         String   @id @default(cuid())
  status     String
  message    String?
  details    String?
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggeredById String?
  triggeredBy   User? @relation(fields: [triggeredById], references: [id])
  createdAt  DateTime @default(now())

  @@index([workflowId])
}

// ─── Reminders & Notifications ──────────────────────────────────────

model Reminder {
  id             String   @id @default(cuid())
  type           String
  scheduledFor   DateTime
  sentAt         DateTime?
  status         String   @default("PENDING")
  message        String?

  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([scheduledFor])
  @@index([status])
}

// ─── Agency: Projects & Tasks ───────────────────────────────────────

model Project {
  id             String    @id @default(cuid())
  name           String
  description    String?
  status         String    @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | ARCHIVED
  health         String    @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK
  startDate      DateTime  @default(now())
  dueDate        DateTime?
  budget         Float?

  clientId       String?
  client         Customer? @relation(fields: [clientId], references: [id])
  leadId         String?
  lead           User?     @relation("ProjectLead", fields: [leadId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tasks Task[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         String    @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | BLOCKED | DONE
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate        DateTime?
  completedAt    DateTime?

  assigneeId     String?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([assigneeId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

// ─── Agency: Activity Feed ──────────────────────────────────────────

model Activity {
  id             String   @id @default(cuid())
  type           String   // TASK_CREATED | TASK_COMPLETED | TASK_STATUS | PROJECT_CREATED | PROJECT_UPDATE | INVOICE_SENT | PAYMENT_RECEIVED | CLIENT_ADDED | NOTE
  message        String
  entityType     String?  // "task" | "project" | "invoice" | "payment" | "customer"
  entityId       String?

  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ─── Gmail Integration ──────────────────────────────────────────────

model GmailAccount {
  id           String    @id @default(cuid())
  email        String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  scope        String?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
