# ---------------------------------------------------------------------------
# Retry Arcade configuration. Everything is optional: with no env vars the site
# runs fully (no ads, in-memory leaderboards/analytics).
# ---------------------------------------------------------------------------

# Public URL (used for sitemap, canonical links, share links, OG images)
NEXT_PUBLIC_SITE_URL=https://retryarcade.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@retryarcade.com
NEXT_PUBLIC_TWITTER=@retryarcade

# --- Data store (leaderboards, analytics, newsletter) ------------------------
# Upstash Redis or Vercel KV (Vercel Marketplace -> Upstash, free tier is enough to start)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Password for /studio dashboard and /api/stats (required in production)
STUDIO_TOKEN=change-me-to-a-long-random-string

# --- Monetization: Google AdSense ---------------------------------------------
# Publisher id from AdSense (enables display ads, H5 game interstitials + rewarded ads, ads.txt)
NEXT_PUBLIC_ADSENSE_CLIENT=
# 'adsense' | 'dev' (simulated ads for testing) | 'none'
NEXT_PUBLIC_ADS_PROVIDER=
# Set to 1 while waiting for H5 Games Ads approval to get test ads
NEXT_PUBLIC_ADS_TEST=
# Display ad unit slot ids (AdSense -> Ads -> By ad unit)
NEXT_PUBLIC_AD_SLOT_GAME_SIDE=
NEXT_PUBLIC_AD_SLOT_GAME_BELOW=
NEXT_PUBLIC_AD_SLOT_HOME=
NEXT_PUBLIC_AD_SLOT_RAIL=
# Interstitial pacing (also A/B tested via the ad_every experiment)
NEXT_PUBLIC_INTERSTITIAL_EVERY=3
NEXT_PUBLIC_INTERSTITIAL_MIN_GAP=60
# Extra ads.txt lines, separated by \n
ADS_TXT_EXTRA=
# Or redirect /ads.txt to a hosted one (Ezoic: https://srv.adstxtmanager.com/<id>/<domain>)
ADS_TXT_REDIRECT=

# --- Monetization: display network (fills the ad slots) ------------------------
# adsense | adsterra | ezoic | house (our own promos, default before any network) | none
NEXT_PUBLIC_DISPLAY_NETWORK=
# Adsterra: one key per banner size from Adsterra -> Websites -> Get code
NEXT_PUBLIC_ADSTERRA_KEYS=300x250:xxxx,728x90:xxxx,320x50:xxxx,160x600:xxxx
# Only if Adsterra's code shows a different host than www.highperformanceformat.com
NEXT_PUBLIC_ADSTERRA_HOST=
# Ezoic placeholder ids per slot
NEXT_PUBLIC_EZOIC_IDS=gameSide:101,gameBelow:102,homeInline:103,rail:104

# --- Monetization: direct revenue -------------------------------------------
# Retry Arcade Plus (ad-free pass) via a Stripe Payment Link. Set the link's
# "After payment" redirect to <site>/plus/thanks?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_PLUS_LINK=
NEXT_PUBLIC_PLUS_PRICE=$4.99 / year
STRIPE_SECRET_KEY=
STRIPE_PLUS_PAYMENT_LINK_ID=
# Pass length in days (0 = lifetime)
PLUS_DAYS=365
# Tip jar (Ko-fi, Buy Me a Coffee, Stripe link)
NEXT_PUBLIC_SUPPORT_URL=
# Current Daily Arena sponsor (JSON), e.g.
# {"name":"Acme","url":"https://acme.com/?utm_source=retryarcade","logo":"https://acme.com/logo.png","tagline":"Snacks for gamers","until":"2026-10-31"}
NEXT_PUBLIC_SPONSOR=
# Email each sponsor enquiry from /advertise (optional, via resend.com)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_FROM_EMAIL=

# --- SEO / verification -----------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
# Daily IndexNow cron auth (Vercel sends it automatically when set)
CRON_SECRET=

# --- Social profiles (footer links + Organization sameAs) ---------------------
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_REDDIT=
NEXT_PUBLIC_SOCIAL_PINTEREST=

# --- Optional third-party analytics --------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
