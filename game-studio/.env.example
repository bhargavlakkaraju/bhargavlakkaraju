# ---------------------------------------------------------------------------
# Retry Arcade configuration. Everything is optional: with no env vars the site
# runs fully (no ads, in-memory leaderboards/analytics).
# ---------------------------------------------------------------------------

# Public URL (used for sitemap, canonical links, share links, OG images)
NEXT_PUBLIC_SITE_URL=https://retryarcade.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@retryarcade.com
NEXT_PUBLIC_TWITTER=@retryarcade

# --- Data store (leaderboards, analytics, newsletter) ------------------------
# Upstash Redis or Vercel KV (Vercel Marketplace -> Upstash, free tier is enough to start)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Password for /studio dashboard and /api/stats (required in production)
STUDIO_TOKEN=change-me-to-a-long-random-string

# --- Monetization: Google AdSense ---------------------------------------------
# Publisher id from AdSense (enables display ads, H5 game interstitials + rewarded ads, ads.txt)
NEXT_PUBLIC_ADSENSE_CLIENT=
# 'adsense' | 'dev' (simulated ads for testing) | 'none'
NEXT_PUBLIC_ADS_PROVIDER=
# Set to 1 while waiting for H5 Games Ads approval to get test ads
NEXT_PUBLIC_ADS_TEST=
# Display ad unit slot ids (AdSense -> Ads -> By ad unit)
NEXT_PUBLIC_AD_SLOT_GAME_SIDE=
NEXT_PUBLIC_AD_SLOT_GAME_BELOW=
NEXT_PUBLIC_AD_SLOT_HOME=
NEXT_PUBLIC_AD_SLOT_RAIL=
# Interstitial pacing (also A/B tested via the ad_every experiment)
NEXT_PUBLIC_INTERSTITIAL_EVERY=3
NEXT_PUBLIC_INTERSTITIAL_MIN_GAP=60
# Extra ads.txt lines, separated by \n
ADS_TXT_EXTRA=

# --- Optional third-party analytics --------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
