# SQLite database (local file, zero setup). For production you can switch
# the prisma datasource provider to postgresql and point this at your DB.
DATABASE_URL="file:./dev.db"

# Optional: any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Ollama…).
# When unset, AI features fall back to the built-in rules engine — the app
# stays fully functional either way.
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
