# --- Database: Neon / Vercel Postgres (pooled connection string) ---
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Files: Vercel Blob (public store) ---
BLOB_READ_WRITE_TOKEN=

# --- xAI: portrait re-frame (grok-imagine-image-2.0), note OCR (grok-4.6), Grok Imagine Video 1.5 ---
XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_TEXT_MODEL=grok-4.6
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# XAI_VIDEO_RESOLUTION=720p
# Trusted-partner accounts may pass the testimonial audio straight into Grok (clips <= 15 s, no lip-sync step).
# XAI_REFERENCE_AUDIO=false

# --- Voice: ElevenLabs (eleven_v3 covers hi, bn, ta, te, kn, mr, gu, pa, ml, en) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_v3
# Optional voice overrides (ElevenLabs voice ids). Defaults are ElevenLabs premade voices.
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=
# Per-language overrides win, e.g. ELEVENLABS_VOICE_HI_FEMALE=...

# --- Lip-sync: sync.so (audio-driven mouth re-timing on the Grok clip) ---
SYNC_API_KEY=
# SYNC_LIPSYNC_MODEL=lipsync-2-pro

# --- Public site URL used in canonical links ---
# SITE_URL=https://portraitvoice.vercel.app
