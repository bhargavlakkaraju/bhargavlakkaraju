# Optional server-only token. When blank, use the existing authenticated
# Higgsfield CLI on this machine (the token is never sent to the browser).
HIGGSFIELD_API_KEY=
# Set this only when the CLI is not on the server PATH.
HIGGSFIELD_CLI_PATH=
AVATAR_RESOLUTION=720p

# Optional Supabase persistence. Apply supabase/migrations/0001_portraitvoice.sql.
# Both values are required; never prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Also holds the private workflow registry. Mount this directory on a durable
# volume. Run a single Node process; this registry is not a distributed lock.
LOCAL_DB_PATH=.data/db.json

# Production Node listener (defaults to localhost for this no-login app).
HOST=127.0.0.1
PORT=3000

# Vercel production uses a private Blob store for entries and workflows.
PV_STORAGE=
BLOB_READ_WRITE_TOKEN=
