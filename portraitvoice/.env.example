# Server-only HeyGen API key (Videos write, Assets write, Voices read, Account read).
# Speech uses HeyGen's ElevenLabs v3 engine; no separate ElevenLabs key is needed.
HEYGEN_API_KEY=
APP_URL=http://127.0.0.1:3000
# Note OCR: Vercel deployments authenticate automatically with OIDC.
# Local development can use an AI Gateway key or a fresh `vercel env pull` token.
AI_GATEWAY_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_DB_PATH=.data/db.json
HOST=127.0.0.1
PORT=3000
# Production needs durable shared storage. Private Blob stores media and workflow leases.
PV_STORAGE=
BLOB_READ_WRITE_TOKEN=
